{
  "name": "dsh-tokensave",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "release": "node scripts/release.mjs",
    "build:client": "node scripts/build-client.mjs",
    "test:continue": "node scripts/check-continue-policy.mjs && node scripts/check-auto-continue-flow.mjs",
    "test:auto-commit": "node scripts/check-auto-commit.mjs",
    "test:ui": "node scripts/check-panel-ui.mjs",
    "test:width": "node scripts/check-panel-width.mjs",
    "test:hover": "node scripts/check-hover-corridor.mjs",
    "test:sound": "node scripts/check-alert-kick.mjs",
    "test:sound-sync": "node scripts/check-sound-sync.mjs",
    "test:todo": "node scripts/check-todo-collapse.mjs",
    "test:sidebar": "node scripts/check-sidebar-collapse.mjs",
    "test:dockview": "node scripts/check-dockview-spike.mjs",
    "test:composer-focus": "node scripts/check-composer-focus.mjs",
    "test:nav": "node scripts/check-workbench-nav.mjs",
    "test:composer-resize": "node scripts/check-composer-resize.mjs",
    "test:turn-edits": "node scripts/check-turn-edits.mjs",
    "test:changes-card": "node scripts/check-changes-card.mjs",
    "test:agent-preset": "node scripts/check-agent-preset.mjs",
    "test:composer-status": "node scripts/check-composer-status.mjs",
    "test:desk": "node scripts/check-desk-ux.mjs",
    "test:desk-dock": "node scripts/check-desk-dock.mjs",
    "test:chat-scroll": "node scripts/check-chat-scroll.mjs",
    "test:msg-queue": "node scripts/check-msg-queue.mjs",
    "test:clone": "node scripts/check-clone-project.mjs",
    "test:project-remove": "node scripts/check-project-remove.mjs",
    "test:card-flip": "node scripts/check-card-flip.mjs",
    "test:pending-alert": "node scripts/check-pending-alert.mjs",
    "test:card-layout": "node scripts/check-card-layout.mjs",
    "test:mobile": "node scripts/check-mobile-layout.mjs",
    "test:chrome": "node scripts/check-chrome-position.mjs",
    "test:chrome-geo": "node scripts/check-chrome-geometry.mjs",
    "test:expset": "node scripts/check-expset-panel.mjs",
    "test": "pnpm check && pnpm test:auto-commit && pnpm test:continue && pnpm test:width && pnpm test:hover && pnpm test:sound && pnpm test:sound-sync && pnpm test:pending-alert && pnpm test:todo && pnpm test:chrome && pnpm test:expset && pnpm test:sidebar && pnpm test:composer-focus && pnpm test:nav && pnpm test:composer-resize && pnpm test:turn-edits && pnpm test:composer-status && pnpm test:changes-card && pnpm test:agent-preset && pnpm test:dockview && pnpm test:desk && pnpm test:desk-dock && pnpm test:chat-scroll && pnpm test:msg-queue && pnpm test:clone && pnpm test:project-remove && pnpm test:card-flip && pnpm test:card-layout && pnpm test:mobile && pnpm test:ui"
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.0",
    "esbuild": "^0.28.2",
    "react": "18.3.1",
    "typescript": "^5.9.0"
  }
}
