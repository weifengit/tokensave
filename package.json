{
  "name": "dsh-tokensave",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "release": "node scripts/release.mjs",
    "build:client": "node scripts/build-client.mjs",
    "test:continue": "node scripts/check-continue-policy.mjs && node scripts/check-auto-continue-flow.mjs",
    "test:ui": "node scripts/check-panel-ui.mjs",
    "test:width": "node scripts/check-panel-width.mjs",
    "test:hover": "node scripts/check-hover-corridor.mjs",
    "test:sound": "node scripts/check-alert-kick.mjs",
    "test:todo": "node scripts/check-todo-collapse.mjs",
    "test:sidebar": "node scripts/check-sidebar-collapse.mjs",
    "test:dockview": "node scripts/check-dockview-spike.mjs",
    "test:composer-focus": "node scripts/check-composer-focus.mjs",
    "test:desk": "node scripts/check-desk-ux.mjs",
    "test:desk-dock": "node scripts/check-desk-dock.mjs",
    "test:chat-scroll": "node scripts/check-chat-scroll.mjs",
    "test:msg-queue": "node scripts/check-msg-queue.mjs",
    "test:clone": "node scripts/check-clone-project.mjs",
    "test": "pnpm check && pnpm test:continue && pnpm test:width && pnpm test:hover && pnpm test:sound && pnpm test:todo && pnpm test:sidebar && pnpm test:composer-focus && pnpm test:dockview && pnpm test:desk && pnpm test:desk-dock && pnpm test:chat-scroll && pnpm test:msg-queue && pnpm test:clone && pnpm test:ui"
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.0",
    "esbuild": "^0.28.2",
    "react": "18.3.1",
    "typescript": "^5.9.0"
  }
}
