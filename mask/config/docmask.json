{
  "version": 1,
  "runtime": {
    "enabled": true,
    "regex": true,
    "glossary": true,
    "gliner": true,
    "cache": true,
    "audit": true,
    "hot_reload": true,
    "gliner_threshold": 0.35,
    "auto_persist_sessions": false
  },
  "detectors": {
    "regex": {
      "enabled": true,
      "rules": {
        "cn_mobile": { "enabled": true },
        "cn_id_card": { "enabled": true },
        "email": { "enabled": true },
        "bank_card": { "enabled": true },
        "ipv4": { "enabled": true },
        "ipv6": { "enabled": true },
        "api_key": { "enabled": true },
        "jwt": { "enabled": true },
        "token_assignment": { "enabled": true }
      },
      "custom_rules": [
        {
          "name": "employee_no",
          "type": "EMP_NO",
          "pattern": "\\bEMP-\\d{6}\\b",
          "enabled": false
        }
      ]
    },
    "gliner": {
      "enabled": true,
      "model": "urchade/gliner_small-v2.1",
      "model_path": "",
      "threshold": 0.35,
      "device": "auto",
      "window_chars": 800,
      "window_overlap": 120,
      "required": false
    },
    "glossary": {
      "enabled": true,
      "path": "glossary.json",
      "case_sensitive": false
    }
  },
  "types": {
    "map": {
      "person": "PER",
      "organization": "ORG",
      "location": "LOC",
      "address": "ADDR"
    },
    "custom": [
      {
        "label": "project name",
        "type": "PROJECT",
        "terms": ["天枢计划"],
        "aliases": ["天枢"]
      },
      {
        "label": "client name",
        "type": "CLIENT",
        "terms": ["某某商业银行"]
      },
      {
        "label": "internal code",
        "type": "INTERNAL_CODE",
        "terms": ["TS-2026-001"]
      }
    ],
    "ignore": ["DeepSeek", "GLiNER"]
  },
  "cache": {
    "enabled": true,
    "path": "~/.cache/docmask/detections.db",
    "ttl_hours": 168
  },
  "audit": {
    "enabled": true,
    "fail_on_leak": false
  },
  "session": {
    "persist_dir": "~/.dsh/tokensave/docmask/sessions",
    "auto_persist": false,
    "password_env": "DOCMASK_PASSWORD"
  },
  "ui_overrides": {
    "enabled": true,
    "path": "~/.dsh/tokensave/docmask/runtime.json"
  }
}
